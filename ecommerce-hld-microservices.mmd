flowchart TB

    %% ===================== EDGE =====================
    subgraph EDGE["Edge & Security"]
        CLIENT["Client<br/>Web · Mobile · Admin"]
        CDN["CDN CloudFront + S3"]
        WAF["WAF"]
        LB["Load Balancer"]
        CLIENT --> CDN --> WAF --> LB
    end

    GW["API Gateway<br/>JWT · Rate Limit · Routing"]
    LB --> GW

    %% ===================== SYNC SERVICES =====================
    GW --> US["User Service<br/>PostgreSQL · Redis"]
    GW --> PS["Product Service<br/>MongoDB · Redis"]
    GW --> SS["Search Service<br/>Elasticsearch · Redis"]
    GW --> RS["Recommendation Service<br/>Cassandra · Redis"]
    GW --> CS["Cart Service<br/>MongoDB · Redis"]
    GW --> OS["Order Service<br/>PostgreSQL · Saga Orchestrator"]

    %% ===================== ORDER FLOW =====================
    CS -->|"checkout"| OS
    OS -->|"pay"| PAY["Payment Service<br/>PostgreSQL"]
    PAY --> STRIPE["Razorpay / Stripe"]

    %% ===================== KAFKA =====================
    KAFKA[("Kafka Cluster x3<br/>orders · payments · catalog<br/>inventory · shipments<br/>DLQ + Retry")]

    %% Producers
    PS -.->|"catalog"| KAFKA
    OS -.->|"orders"| KAFKA
    PAY -.->|"payments"| KAFKA
    INV -.->|"inventory"| KAFKA
    SHIP -.->|"shipments"| KAFKA

    %% Consumers
    KAFKA -.->|"catalog"| SS
    KAFKA -.->|"orders, catalog"| RS
    KAFKA -.->|"orders"| INV["Inventory Service<br/>PostgreSQL · Redis"]
    KAFKA -.->|"payments"| SHIP["Shipping Service<br/>PostgreSQL"]
    KAFKA -.->|"payments, shipments"| OS
    KAFKA -.->|"all events"| NOTIF["Notification Service<br/>Cassandra"]

    %% ===================== EXTERNAL =====================
    SHIP --> COURIER["Courier / Logistics API"]
    NOTIF --> EMAIL["Email / SMS Gateway"]

    %% ===================== OBSERVABILITY =====================
    subgraph OBS["Observability · OpenTelemetry"]
        LOG["Logging · ELK"]
        MET["Metrics · Prometheus + Grafana"]
        TRC["Tracing · Jaeger"]
        ALERT["Alerting · PagerDuty"]
        MET --> ALERT
    end

    %% ===================== STYLES =====================
    classDef svc fill:#1e1b4b,stroke:#818cf8,color:#e0e7ff,stroke-width:2px
    classDef ext fill:#422006,stroke:#fb923c,color:#ffedd5,stroke-dasharray:5 5
    classDef kafka fill:#4c0519,stroke:#fb7185,color:#ffe4e6,stroke-width:3px
    classDef edge fill:#27272a,stroke:#a1a1aa,color:#f4f4f5
    classDef gw fill:#312e81,stroke:#a5b4fc,color:#eef2ff,stroke-width:3px
    classDef obs fill:#164e63,stroke:#22d3ee,color:#cffafe

    class US,PS,SS,RS,CS,OS,PAY,INV,SHIP,NOTIF svc
    class STRIPE,COURIER,EMAIL ext
    class KAFKA kafka
    class CLIENT,CDN,WAF,LB edge
    class GW gw
    class LOG,MET,TRC,ALERT obs
